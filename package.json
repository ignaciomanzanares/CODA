{
  "name": "coda-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coda/api",
    "dev:web": "npm run dev -w @coda/web",
    "build": "npm run build -ws",
    "test": "npm run test -w @coda/api",
    "check": "tsc",
    "db:push": "npm run db:push -w @coda/db",
    "db:seed": "npm run db:seed -w @coda/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.40.0"
  }
}
