{
  "name": "coda-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "npm run dev -w @coda/api",
    "dev:web": "npm run dev -w @coda/web",
    "build": "npm run build -ws",
    "test": "npm run test -w @coda/api",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "seed:demo": "npm run seed:demo -w @coda/api",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:add-po-dte-column": "node scripts/add-po-dte-column.mjs",
    "db:seed": "npm run db:seed -w @coda/db",
    "db:reset:sqlite": "npm run reset:sqlite -w @coda/db",
    "db:reset:postgres": "npm run reset:postgres -w @coda/db",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'npm run check --workspaces --if-present'"
    ],
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "multer": "2.2.0",
    "postcss": "8.5.25",
    "ws": "8.21.1",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.3.0",
    "prettier": "^3.9.5",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.4.14"
  }
}
