# CODA web — réplica local del contrato de vercel.json.
# El entrypoint oficial de nginx procesa este template con envsubst
# (solo sustituye variables presentes en el entorno; $uri queda intacta).

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    include /etc/nginx/conf.d/security-headers.inc;

    # Assets con hash: cache inmutable (igual que vercel.json).
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Service worker e index.html SIN cache — crítico para el update flow
    # de la PWA (banner "Nueva versión disponible").
    location = /sw.js {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
    }

    # Estáticos de la PWA servidos tal cual (mismo allowlist que el rewrite
    # de vercel.json: assets/icons/screenshots/splash + archivos raíz).
    location ~ ^/(icons|screenshots|splash)/ {
        try_files $uri =404;
    }
    location ~ ^/(manifest\.json|robots\.txt|sitemap\.xml|favicon\.svg|og-image\.png)$ {
        try_files $uri =404;
    }

    # SPA fallback. `$uri/` sirve los index.html pre-renderizados por ruta
    # (apps/web/scripts/prerender.mjs escribe dist/<ruta>/index.html).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
