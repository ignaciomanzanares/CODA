# ============================================
# CODA Web - Production Environment
# ============================================
# These values are safe to commit (no secrets)
# They're bundled into the frontend at build time
# ============================================

# Debe coincidir con tu servicio en Render (ej. coda-api-fplk.onrender.com)
VITE_API_URL=https://coda-api-fplk.onrender.com
VITE_ENV=production

# CODA Empresas feature flag — keep "false" hasta obtener autorización CMF
# separada alineada al giro exclusivo (Ley N° 21.521).
VITE_ENABLE_CODA_EMPRESAS=false

# Onboarding de primer ingreso (consentimiento + KYC mock + 2FA). Apagado por
# defecto: con OFF, signup/login no cambian. Para activarlo, poné también
# ENABLE_ONBOARDING=true en la API (Render) para el bloqueo de vinculación bancaria.
VITE_ENABLE_ONBOARDING=false