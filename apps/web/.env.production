# ============================================
# CODA Web - Production Environment
# ============================================
# These values are safe to commit (no secrets)
# They're bundled into the frontend at build time
# ============================================

# Dominio propio del API (CNAME → coda-api-fplk.onrender.com en Render, TLS válido).
VITE_API_URL=https://api.codafinance.cl
VITE_ENV=production

# CODA Empresas feature flag — keep "false" hasta obtener autorización CMF
# separada alineada al giro exclusivo (Ley N° 21.521).
VITE_ENABLE_CODA_EMPRESAS=false

# Onboarding de primer ingreso (consentimiento + KYC mock + 2FA). Apagado por
# defecto: con OFF, signup/login no cambian. Para activarlo, poné también
# ENABLE_ONBOARDING=true en la API (Render) para el bloqueo de vinculación bancaria.
VITE_ENABLE_ONBOARDING=true

# Doble evaluador de riesgo: muestra la tarjeta con score tradicional (CMF) +
# score transaccional CODA (Beta), consumiendo /api/risk/evaluation. Encendido a
# pedido de Ignacio (2026-09-03) para que se vea el score transaccional en el panel.
#
# REQUIERE ADEMÁS: RISK_DUAL_SCORE_ENABLED=true en la API (Render). Sin eso el
# endpoint responde 404 en producción y la tarjeta no puede mostrar el score.
VITE_ENABLE_RISK_DUAL_SCORE=true
