# ============================================
# CODA Web - Environment Variables
# ============================================
# Copy this file to .env for local development
# These are bundled into the frontend at build time
# ============================================

# API URL - Backend server
# Development: leave empty (uses Vite proxy to localhost:5000)
# Production: set to your Render API URL (e.g., https://coda-api-fplk.onrender.com)
VITE_API_URL=

# Environment indicator
VITE_ENV=development

# Auth0 Domain (optional - only needed if using Auth0 MFA)
VITE_AUTH0_DOMAIN=
