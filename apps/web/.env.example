# ============================================
# CODA Web - Environment Variables
# ============================================
#
# Plausible Analytics — no requiere variables de entorno, solo registrar
# el dominio en https://plausible.io con data-domain="codafinance.cl"
#
# Copy this file to .env for local development
# These are bundled into the frontend at build time
# ============================================

# API URL - Backend server
# Development: leave empty (uses Vite proxy to localhost:5000)
# Production: set to your Render API URL (e.g., https://coda-api-fplk.onrender.com)
# Si cambias el host, actualiza también <link rel="preconnect"> en index.html para LCP/TTFB.
VITE_API_URL=

# Environment indicator
VITE_ENV=development

# Auth0 Domain (optional - only needed if using Auth0 MFA)
VITE_AUTH0_DOMAIN=

# CODA Empresas feature flag
# Keep "false" by default. Setting to "true" exposes the CODA Empresas UI
# (landing section, header switch, /empresas routes, sitemap entry, etc.).
# Enabling requires a separate CMF authorization aligned to the giro
# exclusivo per Ley N° 21.521 — do NOT flip in production without it.
VITE_ENABLE_CODA_EMPRESAS=false

# Onboarding de primer ingreso (consentimiento + KYC mock + 2FA). OFF por defecto.
VITE_ENABLE_ONBOARDING=false
