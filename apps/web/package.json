{
  "name": "@coda/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:screenshots": "node scripts/generate-pwa-screenshots.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npx vite build && node scripts/prerender.mjs",
    "analyze": "ANALYZE=true vite build --mode production",
    "test": "vitest run",
    "test:pwa": "node scripts/check-pwa-build.mjs",
    "test:pwa:prod": "node scripts/check-pwa-production.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "translate": "node scripts/translate-auto.mjs",
    "translate:en": "node scripts/translate-auto.mjs --source es --target en",
    "translate:es": "node scripts/translate-auto.mjs --source en --target es",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "i18next": "^25.8.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.1",
    "react-i18next": "^16.5.4",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@coda/db": "*",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@replit/vite-plugin-cartographer": "^0.0.11",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
