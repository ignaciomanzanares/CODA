# CODA API - Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://coda_db_user:NNLcQONXFtA3UUtsWB2CVtfd8TNAHK0o@dpg-d5pc834hg0os739f33h0-a.virginia-postgres.render.com/coda_db?sslmode=require
