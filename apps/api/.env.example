# ============================================
# CODA API - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database
# ============================================
# PostgreSQL connection string (REQUIRED in production)
# Neon / Render: usar URL con TLS, p. ej. postgresql://user:pass@host/db?sslmode=require
# Si omites sslmode, la API añade sslmode=require automáticamente para URLs postgres.
# Opcional — solo para `npm run db:push` local: URL **directa** de Neon (sin -pooler) si el push se cuelga.
# DATABASE_URL_MIGRATE=

# Una sola vez tras migración vacía: permite POST /api/auth/recover-migration-password (login con cuenta JWT-sync).
# Generar: openssl rand -base64 24 — desplegar, usar en la web, luego borrar la variable.
# MIGRATION_RECOVERY_SECRET=
# Example: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# SQLite path (development only)
SQLITE_PATH=./dev.db

# ============================================
# Authentication
# ============================================
# Secret key for JWT signing (REQUIRED in production, min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# JWT token expiration (default: 7d)
JWT_EXPIRES_IN=7d

# ============================================
# Auth cookie (Fase A — foundation backwards-compatible)
# ============================================
# Si AUTH_COOKIE_ENABLED=true, login/register/2FA-verify setean el JWT en una
# cookie httpOnly (además del token en JSON), y `authenticate` la acepta como
# fallback del Authorization: Bearer. Default false → comportamiento idéntico al
# actual (solo Bearer). NO activar en prod hasta tener api.codafinance.cl: con la
# API en onrender.com la cookie sería cross-site (third-party) y Safari/Chrome la
# bloquean.
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_NAME=coda_session
# Secure obliga HTTPS (déjalo true en prod; ponlo false solo en dev local http).
AUTH_COOKIE_SECURE=true
# lax | strict | none. 'none' obliga Secure. No usar 'none' hasta resolver dominio.
AUTH_COOKIE_SAMESITE=lax
# Vacío = cookie host-only. Setear '.codafinance.cl' SOLO cuando exista api.codafinance.cl.
AUTH_COOKIE_DOMAIN=
# CSRF para cookies (Fase D); aún no implementado.
COOKIE_CSRF_ENABLED=false
# CSRF Origin/Referer check para mutaciones cookie-auth (CSRF-1). Default false →
# inerte (no bloquea nada). Activar (true) solo tras validar; ver docs/production-readiness.md.
CSRF_ENFORCE=false

# ============================================
# CORS Configuration
# ============================================
# Opcional: orígenes EXTRA (se unen a los defaults en código: codafinance.cl, Vercel, localhost).
# Si solo usas defaults, puedes dejar vacío o no definir CORS_ORIGINS en Render.
# Ejemplo preview Vercel: https://coda-xxx.vercel.app
# CORS_ORIGINS=

# Frontend URL for email links (REQUIRED in production)
# CLIENT_URL=https://www.codafinance.cl
CLIENT_URL=http://localhost:5173

# ============================================
# Demo Mode (for testing)
# ============================================
# Enable demo authentication in production. Set to 'true' to allow demo login.
# Con DEMO_MODE=true, demo123 SOLO autentica los emails de DEMO_ALLOWED_EMAILS
# (abajo) — nunca cuentas reales.
DEMO_MODE=false
# Custom demo password (default: demo123)
DEMO_PASSWORD=demo123
# Allowlist de cuentas demo: demo123 solo inicia sesión para estos emails
# (separados por coma). Alternativa: DEMO_EMAIL (uno solo). Default: demo@example.com.
DEMO_ALLOWED_EMAILS=demo@example.com

# ============================================
# Feature flags
# ============================================
# Doble evaluador de riesgo (GET /api/risk/evaluation): score tradicional (CMF) +
# score transaccional CODA (Beta). En dev/test va habilitado siempre; en PRODUCCIÓN
# el endpoint responde 404 salvo que esto sea "true" (defensa en profundidad ante
# llamadas directas mientras el modelo no se calibra con outcomes locales).
#
# OJO — flag de DOS LADOS: encender solo el del front (VITE_ENABLE_RISK_DUAL_SCORE=true
# en apps/web/.env.production) hace que la tarjeta se monte pero el endpoint devuelva
# 404. Para que el score se vea en prod hay que encender AMBOS.
RISK_DUAL_SCORE_ENABLED=false

# ============================================
# Observability
# ============================================
# Metrics are disabled by default. In production, METRICS_TOKEN is required when
# METRICS_ENABLED=true. Send it via Authorization: Bearer <token> or X-Metrics-Token.
METRICS_ENABLED=false
METRICS_TOKEN=
# Optional Sentry error capture. If SENTRY_DSN is empty, Sentry is disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ============================================
# Bank / Open Banking (mTLS + FAPI 2.0)
# ============================================
# Client certificate and key for mutual TLS (Base64, e.g. Render/Vercel env)
# Encode with: base64 -w0 client.crt and base64 -w0 client.key
BANK_CERT=
BANK_KEY=
# Identificador del ASPSP para header x-fapi-financial-id
FAPI_FINANCIAL_ID=

# ============================================
# Email Service — REQUERIDO en producción para 2FA OTP y reset de contraseña.
# Configura UN proveedor (orden de preferencia: Resend > Gmail > SMTP). Si no hay
# ninguno: el 2FA falla cerrado (503) y forgot-password no envía correo.
# ============================================
# Resend (preferido: HTTP API, sin timeouts SMTP en hosts cloud)
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "CODA <noreply@codafinance.cl>"
RESEND_FROM=
# Remitente compartido (fallback de RESEND_FROM/SMTP_FROM). Tras dominio: "CODA <noreply@codafinance.cl>"
EMAIL_FROM=noreply@example.com

# SMTP genérico (alternativa a Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail (alternativa a Resend/SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ============================================
# AI Financial Assistant (Optional)
# ============================================
# Configure one of these to enable AI-powered responses.
# Order of preference (más arriba = elegido primero): Groq → Gemini → Anthropic → OpenAI.
# Groq y Gemini tienen tier gratuito generoso; recomendados para desarrollo.

# Groq (Llama 3.3 70B — gratis, rápido, con tool use)
GROQ_API_KEY=

# Google Gemini 2.0 Flash (gratis, con visión y tool use)
# Conseguir clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic (Claude — pago)
ANTHROPIC_API_KEY=

# OpenAI (GPT — pago)
OPENAI_API_KEY=

# ============================================
# Debug/Development (NEVER enable in production)
# ============================================
# Set to 'true' to enable debug endpoints (only works when NODE_ENV != production)
DEBUG_ENDPOINTS=false
