# ============================================
# CODA API - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database
# ============================================
# PostgreSQL connection string (production)
# Example: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# SQLite path (development only)
SQLITE_PATH=./dev.db

# ============================================
# Authentication
# ============================================
# Secret key for JWT signing (use a strong random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Example: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ============================================
# Email Service (optional)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ============================================
# Debug/Development (NEVER enable in production)
# ============================================
# Set to 'true' to enable debug endpoints (only works when NODE_ENV != production)
DEBUG_ENDPOINTS=false
