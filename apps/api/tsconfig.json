{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "types": ["node"],
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ES2021",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@coda/db": ["../../packages/src/index.ts"],
      "@coda/db/*": ["../../packages/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "ml/.venv",
    "src/**/*.test.ts",
    "src/tests/**"
  ]
}
