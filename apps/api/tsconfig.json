{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "types": ["node"],
    "moduleResolution": "node16",
    "module": "ESNext",
    "target": "ES2021",
    "esModuleInterop": true,
    
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@coda/db": ["../../packages/dist/index"],
      "@coda/db/*": ["../../packages/dist/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "ml/.venv",
    "src/**/*.test.ts",
    "src/tests/**",
    "src/vite.ts"
  ]
}
