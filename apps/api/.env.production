# ============================================
# CODA API - Production Environment
# ============================================
# DO NOT commit real secrets to this file!
# Set these values in Render Dashboard → Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=production

# Database - Set via Render Dashboard (use Internal Database URL)
# DATABASE_URL=<set in Render Dashboard>

# Authentication - Generate with: openssl rand -base64 32
# JWT_SECRET=<set in Render Dashboard>

# CORS - Your Vercel frontend URL
CORS_ORIGINS=https://coda-web-steel.vercel.app

# Debug endpoints disabled in production
DEBUG_ENDPOINTS=false