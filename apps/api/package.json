{
  "name": "@coda/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "seed:empresas": "tsx src/seed-empresas.ts",
    "seed:demo": "tsx src/scripts/seed-postgres-demo.ts",
    "seed:products": "tsx src/scripts/seedProducts.ts",
    "db:recategorize": "tsx src/scripts/recategorize.ts",
    "db:normalize-cartolas": "tsx src/scripts/normalize-cartolas.ts",
    "db:backfill-source-links": "tsx src/scripts/backfill-source-document-upload-links.ts",
    "db:dedupe-assets": "tsx src/scripts/dedupeAssets.ts",
    "prebuild": "npm --prefix ../../packages run build",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "scoring:demo": "tsx src/services/scoring/demo-score.ts",
    "ml:make:synth": "tsx src/ml/make_synth_training.ts",
    "ml:setup": "python3 -m venv src/ml/.venv && src/ml/.venv/bin/python -m pip install -U pip setuptools wheel && src/ml/.venv/bin/pip install -r src/ml/requirements.txt",
    "ml:train": "src/ml/.venv/bin/python src/ml/train_xgb.py --in src/ml/out/synth_features.csv --out src/ml/artifacts/current --label label"
  },
  "dependencies": {
    "@coda/db": "*",
    "@napi-rs/canvas": "^0.1.94",
    "@sentry/node": "^10.62.0",
    "@types/cors": "^2.8.19",
    "canvas": "^3.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.5.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mupdf": "^1.27.0",
    "nodemailer": "^7.0.5",
    "onnxruntime-node": "1.19.2",
    "openai": "^5.7.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.624",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "resend": "^6.12.3",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^7.0.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.5",
    "esbuild": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^4.0.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
