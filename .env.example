# CODA API Environment Variables

# ============================================================================
# DATABASE
# ============================================================================

# Production (PostgreSQL on Render)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Development (SQLite)
# DATABASE_URL=file:./coda.db

DATABASE_URL=

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret for token signing (MUST be strong in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session cookie settings
COOKIE_MAX_AGE=2592000000
COOKIE_SECURE=false

# ============================================================================
# CORS & CLIENT
# ============================================================================

# Frontend URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://coda-web-steel.vercel.app

# ============================================================================
# OPEN BANKING (SFA/REDEC)
# ============================================================================

# SFA API credentials (when available in 2027-2028)
SFA_CLIENT_ID=
SFA_CLIENT_SECRET=
SFA_BASE_URL=https://api.sfa.cl

# ============================================================================
# EMAIL (SMTP)
# ============================================================================

# Email service for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@coda.cl

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# OpenAI API for financial assistant (optional)
OPENAI_API_KEY=

# AWS S3 for document storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=coda-documents
AWS_REGION=us-east-1

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable demo mode (allows demo user login)
DEMO_MODE=false

# Enable debug endpoints (only in development)
DEBUG_ENDPOINTS=false

# Enable 2FA (two-factor authentication)
ENABLE_2FA=false

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ============================================================================
# ML & CREDIT SCORING
# ============================================================================

# Python executable path (for ML inference)
PYTHON_PATH=python3

# ML model path (for enhanced credit scoring)
ML_MODEL_PATH=./apps/api/ml/models/ensemble_v2.pkl

# Enable enhanced ML scoring (vs simple rules)
USE_ENHANCED_ML_SCORING=false

# ============================================================================
# COMPLIANCE
# ============================================================================

# Use PostgreSQL for audit persistence (vs in-memory)
USE_DB_AUDIT_PERSISTENCE=false

# Audit data retention (days)
AUDIT_RETENTION_DAYS=2555

# Enable drift monitoring (requires cron job)
ENABLE_DRIFT_MONITORING=false

# ============================================================================
# PERFORMANCE
# ============================================================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Upload limits
MAX_FILE_SIZE_MB=10

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Node environment
NODE_ENV=development

# API Port
PORT=5000
