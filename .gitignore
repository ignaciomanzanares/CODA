# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.*.local
apps/**/.env
apps/**/.env.local
apps/**/.env.production
!.env.example
!apps/**/.env.example

# Database files (SQLite)
*.db
*.db-shm
*.db-wal

# Editor settings
.vscode/
.idea/
.cursor/

# Generated files
/packages/src/*.d.ts
/packages/src/*.js
/apps/web/src/lib/*.d.ts
/apps/web/src/types/*.d.ts

# Drizzle output
/drizzle/
/packages/drizzle/

# Python virtual environment (ML models)
.venv/
__pycache__/
*.pyc
*.pyo

# Cache directories
.cache/
.turbo/

# Logs
*.log
npm-debug.log*

# Misc
*.tar.gz
*.tmp
tmp-*

# tesseract.js language models (downloaded at runtime, cached)
*.traineddata
