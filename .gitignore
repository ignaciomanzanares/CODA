# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.*.local
apps/**/.env
apps/**/.env.local
apps/**/.env.production
!.env.example
!apps/**/.env.example

# Database files (SQLite)
*.db
*.db-shm
*.db-wal

# Editor settings
.vscode/
.idea/
.cursor/

# Generated files
/packages/src/*.d.ts
/packages/src/*.js
/apps/web/src/lib/*.d.ts
/apps/web/src/types/*.d.ts

# Drizzle output
/drizzle/
/packages/drizzle/

# Python virtual environment (ML models)
.venv/
__pycache__/
*.pyc
*.pyo

# Dataset de terceros (Kaggle) descargado por prepare_kaggle_benchmark.py — no redistribuir.
apps/api/src/ml/out/kaggle_benchmark_features.csv
# CSVs de entrenamiento generados (se regeneran con ml:make:synth; no versionar).
apps/api/src/ml/out/*.csv
# Artefactos de modelo entrenados (#5): solo `current/` queda versionado como fallback;
# las versiones nuevas viven en el blob store y se promueven por fila en algorithm_model_versions.
apps/api/src/ml/artifacts/*
!apps/api/src/ml/artifacts/current/
# Cache de descarga del modelo de producción desde el blob store (runtime).
apps/api/src/ml/artifacts/_remote_production/

# Cache directories
.cache/
.turbo/

# Logs
*.log
npm-debug.log*

# Misc
*.tar.gz
*.tmp
tmp-*

# tesseract.js language models (downloaded at runtime, cached)
*.traineddata
