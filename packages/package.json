{
  "name": "@coda/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    }
    ,
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=../drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=../drizzle.config.ts",
    "db:push": "drizzle-kit push --config=../drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=../drizzle.config.ts",
    "seed": "tsx src/seed.ts",
    "reset:sqlite": "rm -f ../data/coda.db && SQLITE_PATH=../data/coda.db DIALECT=sqlite npm run db:push && npm run seed",
    "reset:postgres": "DATABASE_URL=$DATABASE_URL DIALECT=postgresql npm run db:push && npm run seed"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.7.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
